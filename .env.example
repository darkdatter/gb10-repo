# Copy to .env (gitignored) and fill in. Nothing here is committed.
GB10_BASE_URL=http://127.0.0.1:8000/v1
GB10_API_KEY=
GB10_MODEL=default

# Standalone SGLang instead of the SparkStation gateway:
# GB10_BASE_URL=http://127.0.0.1:8888/v1
# GB10_MODEL=qwen3.8-27b-sglang

# Concurrent workers for HumanEval generation. Keep <= max_running_requests.
GB10_WORKERS=4
